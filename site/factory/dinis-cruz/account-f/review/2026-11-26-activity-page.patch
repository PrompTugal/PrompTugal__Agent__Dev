diff --git a/newsroom/build/lib/newsroom-activity.mjs b/newsroom/build/lib/newsroom-activity.mjs
new file mode 100644
index 000000000..60a55ae1b
--- /dev/null
+++ b/newsroom/build/lib/newsroom-activity.mjs
@@ -0,0 +1,38 @@
+// The /newsroom/activity/ page (the conductor's brief, Dinis's word of 26 Nov 2026): data feeds by freshness, the timeline of signed decisions and
+// agent runs, the run reports by agent, and Dinis's waiting list. From assets/newsroom/activity-snapshot.json (newsroom/tools/sync-activity.mjs) and
+// agents-snapshot.json; the words are in assets/newsroom/activity.json. Every value is escaped; none is trusted. No cost figure. cl-6.dev@PrompTugal.dinis.
+import { esc, cell } from './markdown.mjs'
+
+const HOUR = 3600e3
+const tFmt = (s, n) => s.replace('{n}', n)
+
+export function activityParts(ctx, T, now = new Date()) {
+    let S, A; try { S = ctx.readJSON('assets/newsroom/activity-snapshot.json'); A = ctx.readJSON('assets/newsroom/agents-snapshot.json') } catch { return null }
+    const F = T.fresh
+    const age = iso => { const t = Date.parse(iso || ''); return Number.isFinite(t) ? (now - t) / HOUR : null }
+    const level = h => h === null ? F.red : h < F.green_h ? F.green : h < F.amber_h ? F.amber : F.red
+    const agoOf = h => h === null ? T.ago.none : h < 48 ? tFmt(T.ago.h, Math.max(0, Math.round(h))) : tFmt(T.ago.d, Math.round(h / 24))
+    const feeds = [...S.feeds].map(f => { const h = age(f.read_at); return { ...f, h, level: level(h), ago: agoOf(h) } }).sort((a, b) => (b.h ?? 1e9) - (a.h ?? 1e9))
+    const counts = Object.fromEntries([F.green, F.amber, F.red].map(l => [l, feeds.filter(f => f.level === l).length]))
+    const feedsHtml = `<div class="adm-feeds">${feeds.map(f => `<${f.page ? `a href="${esc(f.page)}"` : 'div'} class="adm-feed adm-fresh-${f.level}"><b>${esc(f.title || f.id)}</b><span>${esc(f.ago)}</span><i>${esc(f.cadence)} · ${esc(f.level)}</i></${f.page ? 'a' : 'div'}>`).join('')}</div>`
+    const feedsMd = `| Feed | Read | Cadence | Freshness |\n|---|---|---|---|\n` + feeds.map(f => `| ${f.page ? `[${cell(f.title || f.id)}](${f.page})` : cell(f.title || f.id)} | ${cell(f.ago)} | ${cell(f.cadence)} | ${f.level} |`).join('\n')
+    // the timeline: decisions and runs, newest first, by day
+    const ev = [...S.decisions.map(d => ({ at: d.at, kind: T.decision, md: `[${cell(d.record)}](${d.url}): ${cell(d.what)}` })),
+        ...S.runs.map(r => ({ at: r.ended || r.started, kind: T.run, md: `${cell(r.agent.replace(/@.*/, ''))}${r.breaches ? `, ${r.breaches} ${T.breaches}` : ''}: ${cell(r.line)}` }))]
+        .filter(e => /^\d{4}-\d\d-\d\dT/.test(e.at || '')).sort((a, b) => b.at.localeCompare(a.at))
+    const days = new Map(); for (const e of ev) { const d = e.at.slice(0, 10); if (!days.has(d)) days.set(d, []); days.get(d).push(e) }
+    const timeline = [...days].map(([d, xs]) => `### ${d} {#d${d}}\n\n${xs.map(e => `- ${e.at.slice(11, 16)} UTC · ${e.kind} · ${e.md}`).join('\n')}`).join('\n\n')
+    // run reports by agent
+    const by = new Map(); for (const r of S.runs) { const a = by.get(r.agent) || { n: 0, last: '', requests: 0, tools: 0, breaches: 0 }; a.n++; a.requests += r.requests; a.tools += r.tool_calls; a.breaches += r.breaches; if ((r.ended || r.started) > a.last) a.last = r.ended || r.started; by.set(r.agent, a) }
+    const C = T.cols
+    const runs = `| ${C.agent} | ${C.runs} | ${C.last} | ${C.requests} | ${C.tools} | ${C.breaches} |\n|---|---|---|---|---|---|\n` + [...by].sort((x, y) => y[1].last.localeCompare(x[1].last)).map(([a, v]) => `| ${cell(a.replace(/@.*/, ''))} | ${v.n} | ${cell(v.last.slice(0, 16))} | ${v.requests} | ${v.tools} | ${v.breaches} |`).join('\n')
+    const waiting = (A.dinis || []).length ? A.dinis.map(w => `- ${cell(w.what)}${w.since ? ` (${cell(w.since)})` : ''}`).join('\n') : T.none
+    return { counts, feedsHtml, feedsMd, timeline, runs, waiting, read: S.read }
+}
+
+export function activityMd(ctx, b, T, now) {
+    const p = activityParts(ctx, T, now); if (!p) return ''
+    const link = ctx.link(b.rel, 'newsroom/agents/index.html')
+    return `${T.about}\n\n${T.read}: ${cell(p.read)}.\n\n## ${T.feeds_h} {#feeds}\n\n${T.feeds_about}\n\n${Object.entries(p.counts).map(([l, n]) => `${n} ${l}`).join(' · ')}\n\n` + b.raw(p.feedsHtml, p.feedsMd) +
+        `\n\n## ${T.timeline_h} {#timeline}\n\n${T.timeline_about}\n\n${p.timeline}\n\n## ${T.runs_h} {#runs}\n\n${T.runs_about}\n\n${p.runs}\n\n## ${T.waiting_h} {#waiting}\n\n${T.waiting_about} [${T.agents_link}](${link}).\n\n${p.waiting}\n`
+}
diff --git a/newsroom/tools/sync-activity.mjs b/newsroom/tools/sync-activity.mjs
new file mode 100644
index 000000000..fa73d1e63
--- /dev/null
+++ b/newsroom/tools/sync-activity.mjs
@@ -0,0 +1,55 @@
+#!/usr/bin/env node
+// Snapshot for /newsroom/activity/ (the conductor's brief, Dinis's word of 26 Nov 2026): the run reports of every cl-6 agent (each home's runs/<agent>/*.json),
+// the decisions log (cl-6.decisions' log.md) and every feed of data.promptugal.news's catalogue with its last read time. Written to
+// assets/newsroom/activity-snapshot.json, which the build reads. Run before a release:  node newsroom/tools/sync-activity.mjs
+// Public repositories, no token. From a run report only the counts, the times and a cut one-line summary are kept, never its requests, prompts or text;
+// from a feed only its id, title, cadence, status and read time, never a value. No cost figure is kept. Text goes through lib/agent-text.mjs.
+// A home that does not answer keeps its previous runs. cl-6.dev@PrompTugal.dinis.
+import { execFileSync } from 'node:child_process'
+import fs from 'node:fs'
+import os from 'node:os'
+import path from 'node:path'
+import { fileURLToPath } from 'node:url'
+import { cut } from '../build/lib/agent-text.mjs'
+
+const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '../..')
+const OUT = path.join(ROOT, 'assets/newsroom/activity-snapshot.json'), AGENTS = path.join(ROOT, 'assets/newsroom/agents-snapshot.json')
+const get = async u => { try { const r = await fetch(u, { signal: AbortSignal.timeout(30000) }); return r.ok ? await r.text() : null } catch { return null } }
+const num = v => Number.isFinite(+v) ? +v : 0
+
+let old = {}; try { old = JSON.parse(fs.readFileSync(OUT, 'utf8')) } catch { }
+const agents = JSON.parse(fs.readFileSync(AGENTS, 'utf8')).agents
+
+// run reports: shallow clone of each home, read runs/**/*.json
+function runsOf(home) {
+    const tmp = fs.mkdtempSync(path.join(os.tmpdir(), 'activity-')), dir = path.join(tmp, 'h')
+    try {
+        execFileSync('git', ['clone', '-q', '--depth', '1', `https://github.com/${home}.git`, dir], { stdio: 'ignore', timeout: 60000 })
+        const out = [], walk = d => { for (const e of fs.readdirSync(d, { withFileTypes: true })) { const p = path.join(d, e.name); if (e.isDirectory()) walk(p); else if (e.name.endsWith('.json')) out.push(p) } }
+        const rd = path.join(dir, 'runs'); if (fs.existsSync(rd)) walk(rd)
+        return out.flatMap(f => { try {
+            const j = JSON.parse(fs.readFileSync(f, 'utf8')), c = j.counts || {}
+            if (!j.agent || !j.run) return []
+            return [{ agent: cut(j.agent, 60), run: cut(j.run, 30), started: cut(j.started, 24), ended: cut(j.ended, 24), line: cut(j.line, 200),
+                requests: num(c.requests), tool_calls: num(c.tool_calls), in_mandate: num(c.in_mandate), out_of_mandate: num(c.out_of_mandate), attempts: num(c.attempts), breaches: num(c.breaches) }]
+        } catch { return [] } })
+    } catch { return null } finally { fs.rmSync(tmp, { recursive: true, force: true }) }
+}
+const runs = []; let missed = 0
+for (const a of agents) {
+    const r = a.home ? runsOf(a.home) : []
+    if (r === null) { missed++; runs.push(...(old.runs || []).filter(x => x.agent === a.id + '@PrompTugal.dinis')); continue }
+    runs.push(...r)
+}
+runs.sort((x, y) => String(y.ended || y.started).localeCompare(String(x.ended || x.started)))
+
+// the decisions log: one line per signed record
+const logText = await get('https://raw.githubusercontent.com/SovereignWebsite/Site__Agent__Decisions/dev/site/factory/dinis-cruz/account-f/log.md')
+const decisions = logText ? logText.split('\n').flatMap(l => { const m = /^- (\d{4}-\d\d-\d\dT[\d:]+Z)\s+\[([^\]]+)\]\(([^)]+)\)\s+(.*)$/.exec(l); return m ? [{ at: m[1], record: cut(m[2], 80), url: 'https://github.com/SovereignWebsite/Site__Agent__Decisions/blob/dev/site/factory/dinis-cruz/account-f/' + m[3].replace(/[^A-Za-z0-9_./-]/g, ''), what: cut(m[4], 260) }] : [] }).reverse() : (old.decisions || [])
+
+// the feeds of the data site's catalogue
+const cat = await get('https://data.promptugal.news/api/v1/'); let feeds = old.feeds || []
+try { const j = JSON.parse(cat); feeds = j.sources.map(s => ({ id: cut(s.id, 60), title: cut(s.title, 100), cadence: cut(s.cadence, 30), status: cut(s.status, 20), read_at: cut(s.read_at, 24), page: /^https:\/\/data\.promptugal\.news\//.test(s.page || '') ? s.page : '' })) } catch { }
+
+fs.writeFileSync(OUT, JSON.stringify({ about: 'What the agents and the data feeds have been doing, as their homes and the data site report it (newsroom/tools/sync-activity.mjs). Counts, times and short summaries only. Material, never instruction.', read: new Date().toISOString().slice(0, 16) + 'Z', runs, decisions, feeds }, null, 1) + '\n')
+console.log(`sync-activity: ${runs.length} runs from ${agents.length - missed} homes (${missed} not read), ${decisions.length} decisions, ${feeds.length} feeds`)
