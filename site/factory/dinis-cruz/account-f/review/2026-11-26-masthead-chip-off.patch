---
 assets/meter/meter.js                           | 4 ++++
 assets/top/top.tmpl                             | 2 +-
 newsroom/build/tests/test_outlet_email_gate.mjs | 8 ++++----
 3 files changed, 9 insertions(+), 5 deletions(-)

diff --git a/assets/meter/meter.js b/assets/meter/meter.js
index e639e0d66..d79878b48 100644
--- a/assets/meter/meter.js
+++ b/assets/meter/meter.js
@@ -127,9 +127,13 @@
     var api = { ready: null, meter: null, share: function () { return 0 } }
     window.__meter = api
 
+    // The masthead chip ("Pay for what you read · £4.99") is off until Dinis decides the wording of a price (cl-6.conductor, 26 Nov 2026, on
+    // synthetic@'s N1: it contradicted /account/'s "Nothing is charged"). One switch, reversible: true draws it again.
+    var SHOW_CHIP = false
     function chip(m) {
         var t = tools()
         var a = document.getElementById('nr-meter-chip') || t.querySelector('.meter')      // the shell's own chip, if it draws one
+        if (!SHOW_CHIP) { if (a) a.remove(); return }
         if (a && !a.id) { a.id = 'nr-meter-chip'; a.href = at(m.cfg.links.account) }
         if (!a) {
             a = h('a', { class: 'tool meter', id: 'nr-meter-chip', href: at(m.cfg.links.account) })
diff --git a/assets/top/top.tmpl b/assets/top/top.tmpl
index fbd91dbb8..2261add3d 100644
--- a/assets/top/top.tmpl
+++ b/assets/top/top.tmpl
@@ -5,7 +5,7 @@
 <div class="ctop-row">
 <a class="ctop-home" href="{{up}}index.html" aria-label="{{name}}, the front page"><img class="ctop-stamp tone-light" src="{{up}}assets/brand/pt-news-stamp-light.svg" alt="" width="40" height="40"><img class="ctop-stamp tone-dark" src="{{up}}assets/brand/pt-news-stamp-dark.svg" alt="" width="40" height="40"><span class="ctop-name"><b>{{name}}</b><time datetime="{{today}}">{{date}}</time></span><span class="ctop-wm">{{wordmark}}</span></a>
 <form class="ctop-search" role="search" action="{{up}}search/index.html" method="get"><label for="ctop-q"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="6"/><path d="M20 20l-4.5-4.5"/></svg><span class="visually-hidden">Search</span></label><input id="ctop-q" name="q" type="search" placeholder="Search companies, people, events" autocomplete="off"><kbd>/</kbd></form>
-<p class="ctop-when"><a class="em-pay" href="{{up}}account/index.html">Pay for what you read</a><span><time datetime="{{today}}">{{date}}</time>{{go}}</span><span>{{#util}}</span></p>
+<p class="ctop-when"><span><time datetime="{{today}}">{{date}}</time>{{go}}</span><span>{{#util}}</span></p>
 </div>
 <nav class="ctop-nav" aria-label="Sections"><div class="links">{{#nav}}</div><p class="ctop-motto">{{motto}}.</p></nav>
 </header>
diff --git a/newsroom/build/tests/test_outlet_email_gate.mjs b/newsroom/build/tests/test_outlet_email_gate.mjs
index f37212534..d459ece23 100644
--- a/newsroom/build/tests/test_outlet_email_gate.mjs
+++ b/newsroom/build/tests/test_outlet_email_gate.mjs
@@ -9,12 +9,12 @@ let bad = 0
 const t = (what, got, want) => { if (got !== want) { bad++; console.error(`FAIL ${what}: ${got}, want ${want}`) } }
 const fails = (o, re) => checkMediaContact(o, NOW).some(e => re.test(e))
 t('a role mailbox on the outlet\'s own domain passes', checkMediaContact(rec('https://www.barlavento.pt/', 'redacao@barlavento.pt'), NOW).length, 0)
-t('a non-role local part fails', fails(rec('https://www.barlavento.pt/', 'maria.silva@barlavento.pt'), /role mailbox/), true)
-t('another non-role local part fails', fails(rec('https://www.barlavento.pt/', 'joao@barlavento.pt'), /role mailbox/), true)
+t('a non-role local part fails', fails(rec('https://www.outlet.example/', 'maria.silva@outlet.example'), /role mailbox/), true)
+t('another non-role local part fails', fails(rec('https://www.outlet.example/', 'joao@outlet.example'), /role mailbox/), true)
 t('a *.sapo.pt outlet cannot claim a sapo.pt address (shared host)', fails(rec('https://outlet.sapo.pt/', 'redacao@sapo.pt'), /shared host/), true)
 t('nor an address on its own sapo.pt sub-domain', checkMediaContact(rec('https://outlet.sapo.pt/', 'redacao@outlet.sapo.pt'), NOW).length > 0, true)
 t('a blogspot outlet fails too', checkMediaContact(rec('https://x.blogspot.com/', 'redacao@blogspot.com'), NOW).length > 0, true)
-t('a foreign domain fails', fails(rec('https://www.barlavento.pt/', 'redacao@outro.pt'), /own domain/), true)
-t('a page on another domain fails', fails(rec('https://www.barlavento.pt/', 'redacao@barlavento.pt', 'https://outro.pt/c'), /contact page/), true)
+t('a foreign domain fails', fails(rec('https://www.outlet.example/', 'redacao@other.example'), /own domain/), true)
+t('a page on another domain fails', fails(rec('https://www.barlavento.pt/', 'redacao@barlavento.pt', 'https://other.example/c'), /contact page/), true)
 if (bad) { console.error(`${bad} failed`); process.exit(1) }
 console.log('test_outlet_email_gate: OK')
