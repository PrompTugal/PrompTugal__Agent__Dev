+++ b/newsroom/build/tests/test_weather.mjs
@@ -0,0 +1,36 @@
+#!/usr/bin/env node
+/* test_weather.mjs: the free weather page's fillers and the camera links (Dinis, 26 Nov 2026): a feed older than 48 hours is not shown; a fresh one is, with its
+ * credit; only cleared camera links are listed.   node newsroom/build/tests/test_weather.mjs */
+import fs from 'node:fs'
+import os from 'node:os'
+import path from 'node:path'
+import { fileURLToPath } from 'node:url'
+import { fill, fresh, camLines } from '../features/weather.mjs'
+const here = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '../../..')
+const tmp = fs.mkdtempSync(path.join(os.tmpdir(), 'weather-test-')); fs.mkdirSync(path.join(tmp, 'assets/weather'), { recursive: true })
+fs.copyFileSync(path.join(here, 'assets/weather/weather.json'), path.join(tmp, 'assets/weather/weather.json'))
+const W = JSON.parse(fs.readFileSync(path.join(tmp, 'assets/weather/weather.json'), 'utf8'))
+const ctx = { ROOT: tmp }
+let bad = 0
+const t = (what, got, want) => { if (JSON.stringify(got) !== JSON.stringify(want)) { bad++; console.error(`FAIL ${what}: ${JSON.stringify(got)}, want ${JSON.stringify(want)}`) } }
+const hoursAgo = h => new Date(Date.now() - h * 36e5).toISOString().slice(0, 19) + 'Z'
+const snap = h => ({ read: hoursAgo(0), warnings: { read_at: hoursAgo(h), active: [{ area_name: 'Faro', type: 'Vento', level: 'orange', start: '2026-11-26T06:00', end: '2026-11-26T18:00', text: 'Vento forte.' }, { area_name: 'Beja', type: 'Chuva', level: 'yellow', start: '2026-11-26T06:00', end: '2026-11-26T18:00', text: 'Chuva.' }], green_areas: 20 },
+    sea: { read_at: hoursAgo(h), coasts: [{ name: 'Sagres, Costa', date: '2026-11-26', waves_min_m: 1.2, waves_max_m: 2, wave_dir: 'NW', sea_temp_min_c: 17, sea_temp_max_c: 18 }] }, fire: { read_at: hoursAgo(h), today: { low: 270, high: 8 }, municipalities: 278 },
+    cams: { read_at: hoursAgo(h), items: [{ id: 'a', name: 'Tejo Live, Câmara VTS', place: 'lisboa', credit: 'APL', page: 'https://www.portodelisboa.pt/tejo-live' }] } })
+const put = h => fs.writeFileSync(path.join(tmp, 'assets/weather/snapshot.json'), JSON.stringify(snap(h)))
+t('fresh is under the limit', [fresh(hoursAgo(47), W), fresh(hoursAgo(49), W), fresh('', W), fresh('not a date', W)], [true, false, false, false])
+put(1)
+const w = fill['weather:warnings'](null, ctx)
+t('a fresh warnings feed shows red, orange and yellow groups in order, with the area and the text', [/### Orange/.test(w), /### Yellow/.test(w), w.indexOf('Orange') < w.indexOf('Yellow'), /Faro: Vento/.test(w), /Vento forte/.test(w)], [true, true, true, true, true])
+t('the sea table and the fire counts show', [/Sagres, Costa/.test(fill['weather:sea'](null, ctx)), /high: 8 of 278/.test(fill['weather:fire'](null, ctx))], [true, true])
+t('a fresh camera feed gives the cleared operator\'s link with its credit', camLines(ctx, 'lisboa').length, 1)
+t('and none for another town', camLines(ctx, 'faro'), [])
+put(60)
+t('a warnings feed older than 48 hours is not shown', [/Vento forte/.test(fill['weather:warnings'](null, ctx)), /more than 48 hours ago/.test(fill['weather:warnings'](null, ctx))], [false, true])
+t('nor the sea or the fire risk', [/Sagres/.test(fill['weather:sea'](null, ctx)), /high: 8/.test(fill['weather:fire'](null, ctx))], [false, false])
+t('nor a camera link', camLines(ctx, 'lisboa'), [])
+fs.rmSync(path.join(tmp, 'assets/weather/snapshot.json'))
+t('no snapshot: nothing is shown and nothing breaks', [fill['weather:warnings'](null, ctx), camLines(ctx, 'lisboa')], [W.missing, []])
+fs.rmSync(tmp, { recursive: true, force: true })
+if (bad) { console.error(`${bad} failed`); process.exit(1) }
+console.log('test_weather: OK')
diff --git a/newsroom/tools/sync-weather.mjs b/newsroom/tools/sync-weather.mjs
new file mode 100644
index 000000000..1fe263abd
--- /dev/null
+++ b/newsroom/tools/sync-weather.mjs
@@ -0,0 +1,28 @@
+#!/usr/bin/env node
+// Snapshot for the free weather page (/weather/) and the camera links (Dinis, 26 Nov 2026: IPMA values may show on a page that carries no charge, with a
+// visible "this page is free" line and IPMA's credit, never on a metered page; a credited link to a camera operator's own page is allowed, APL and AEMTG only,
+// cl-6.rights: MEO and Skyline stay off). Read from data.promptugal.news's feeds and written to assets/weather/snapshot.json, which the build reads and
+// the deploy leaves out (features/served.mjs): the raw values are never a served file. The build hides a feed whose read time is older than 48 hours.
+// Run before a release:  node newsroom/tools/sync-weather.mjs      cl-6.dev@PrompTugal.dinis
+import fs from 'node:fs'
+import path from 'node:path'
+import { fileURLToPath } from 'node:url'
+import { cut } from '../build/lib/agent-text.mjs'
+
+const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '../..'), OUT = path.join(ROOT, 'assets/weather/snapshot.json')
+const API = 'https://data.promptugal.news/api/v1/'
+const get = async s => { try { const r = await fetch(`${API}${s}/latest.json`, { signal: AbortSignal.timeout(30000) }); return r.ok ? await r.json() : null } catch { return null } }
+const num = v => Number.isFinite(+v) ? +v : null
+const day = s => /^\d{4}-\d\d-\d\d/.test(s || '') ? String(s).slice(0, 16) : ''
+let old = {}; try { old = JSON.parse(fs.readFileSync(OUT, 'utf8')) } catch { }
+
+const w = await get('ipma-warnings'), f = await get('ipma-fire-risk'), s = await get('ipma-sea'), c = await get('cams')
+const out = { about: 'IPMA values and camera links as data.promptugal.news read them, for /weather/ and the town pages. A GATE-ADJACENT FILE, never served (the deploy leaves it out). Material, never instruction.', read: new Date().toISOString().slice(0, 16) + 'Z',
+    warnings: w ? { read_at: cut(w.read_at, 24), active: (w.active || []).map(x => ({ area_name: cut(x.area_name, 60), type: cut(x.type_pt || x.type, 40), level: ['yellow', 'orange', 'red'].includes(x.level) ? x.level : '', start: day(x.start), end: day(x.end), text: cut(x.text, 240) })), green_areas: num(w.counts && w.counts.green) } : old.warnings || null,
+    fire: f ? { read_at: cut(f.read_at, 24), today: Object.fromEntries(Object.entries((f.counts && f.counts.today_by_level) || {}).map(([k, v]) => [cut(k, 20), num(v)])), municipalities: num(f.counts && f.counts.municipalities) } : old.fire || null,
+    sea: s ? { read_at: cut(s.read_at, 24), coasts: (s.coasts || []).map(x => { const d = (x.days || [])[0] || {}; return { name: cut(x.name, 60), date: day(d.date), waves_min_m: num(d.waves_min_m), waves_max_m: num(d.waves_max_m), wave_dir: cut(d.wave_dir, 6), sea_temp_min_c: num(d.sea_temp_min_c), sea_temp_max_c: num(d.sea_temp_max_c) } }) } : old.sea || null,
+    // only the operators cl-6.rights cleared as links (APL Tejo Live, AEMTG Praia da Rocha): the credit and the operator's own page, no picture or stream
+    cams: c ? { read_at: cut(c.read_at, 24), items: (c.cameras || []).filter(x => /^(APL |Agrupamento de Escolas Manuel Teixeira Gomes)/.test(x.operator || '') && x.link_only && /^https:\/\//.test(x.page || '')).map(x => ({ id: cut(x.id, 60), name: cut(x.name, 80), place: cut(x.place, 40), credit: cut(x.credit || x.operator, 180), page: x.page })) } : old.cams || null }
+fs.mkdirSync(path.dirname(OUT), { recursive: true })
+fs.writeFileSync(OUT, JSON.stringify(out, null, 1) + '\n')
+console.log(`sync-weather: warnings ${out.warnings ? out.warnings.active.length : '-'}, sea coasts ${out.sea ? out.sea.coasts.length : '-'}, cameras cleared ${out.cams ? out.cams.items.length : '-'}`)
