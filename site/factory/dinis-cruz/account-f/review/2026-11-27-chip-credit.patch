 assets/meter/meter.js | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/assets/meter/meter.js b/assets/meter/meter.js
index 3c156d5e1..ef641abaa 100644
--- a/assets/meter/meter.js
+++ b/assets/meter/meter.js
@@ -143,9 +143,9 @@
         var b = m.state.balance
         a.classList.toggle('is-low', b < 100)
         var shown = m.money(Math.max(0, b))   // never a minus sign (designer@'s spec, 26 Nov 2026)
-        a.replaceChildren(h('span', { class: 'meter-label' }, b > 0 ? 'Pay for what you read · ' : 'Credit used · keep reading · '), h('span', { class: 'meter-short' }, 'Credit '), shown)   // a phone says what the number is: "Credit £4.97" (designer@, 26 Nov, on synthetic@'s N1)
-        a.setAttribute('aria-label', 'Reading credit ' + shown + ', kept in this browser: your account')
-        a.title = b > 0 ? 'You start with ' + m.money(m.cfg.start) + ' of reading credit, kept in this browser. It goes down as you read, by how much of a page you read. When it runs out you can still read everything.' : 'Your credit is used. You can still read everything. Top-ups are coming soon.'
+        a.replaceChildren('Credit ' + shown)   // the same word at every width (designer@, 27 Nov, on synthetic@'s home-page read: "Pay" beside a figure read as a price)
+        a.setAttribute('aria-label', 'Pay for what you read. ' + (b > 0 ? 'Credit left ' : 'Credit used up, ') + shown + ', kept in this browser: your account')
+        a.title = b > 0 ? 'Pay for what you read. Credit left: ' + shown + ', kept in this browser. When it runs out you can still read everything.' : 'Pay for what you read. Your credit is used. You can still read everything. Top-ups are coming soon.'
     }
 
     var REASONS = [['clickbait', 'The headline promised more than the page gave'], ['not-relevant', 'Not relevant to me'], ['did-not-read', 'I did not really read it'], ['other', 'Another reason']]
