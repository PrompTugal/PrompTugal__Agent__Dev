+await rejects('a short passphrase', A.KR.make('short'), /at least 12/)
+const made = await A.KR.make('correct horse battery staple')
+const file = JSON.parse(made.backup)
+t('header', [file.v, file.kind, file.kdf.name, file.kdf.hash, file.kdf.iter, file.enc.name], [1, 'pt-key-backup', 'PBKDF2', 'SHA-256', 600000, 'AES-GCM'])
+t('no plain private component in the file', /"d"\s*:/.test(made.backup), false)
