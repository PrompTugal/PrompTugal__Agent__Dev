+#!/usr/bin/env node
+/* test_keyring_csp.mjs: the gate's CSP check for pages that load the keyring (cl-6.security's S17 R1): a page without the meta, with 'unsafe-inline', with a wildcard,
+ * with the meta not first, or without default-src 'none' fails; the key page's own policy passes.   node newsroom/build/tests/test_keyring_csp.mjs   Written by cl-6.dev@PrompTugal.dinis. */
+import fs from 'node:fs'
+import { cspProblem } from '../features/login.mjs'
+let bad = 0
+const t = (what, got, want) => { if (got !== want) { bad++; console.error(`FAIL ${what}: ${JSON.stringify(got)}, want ${JSON.stringify(want)}`) } }
+const W = JSON.parse(fs.readFileSync(new URL('../../../assets/login/key-page.json', import.meta.url), 'utf8')), policy = W.csp
+const page = (csp, before = '') => `<!doctype html><head><meta charset="utf-8">${before}${csp === null ? '' : `<meta http-equiv="Content-Security-Policy" content="${csp}">`}<title>x</title></head>`
+t('the key page policy passes', cspProblem(page(policy)), '')
+t('no meta fails', !!cspProblem(page(null)), true)
+t("'unsafe-inline' in script-src fails", !!cspProblem(page(policy.replace("script-src 'self'", "script-src 'self' 'unsafe-inline'"))), true)
+t("'unsafe-eval' fails", !!cspProblem(page(policy + "; script-src 'unsafe-eval'")), true)
+t('a wildcard fails', !!cspProblem(page(policy.replace("img-src 'self'", 'img-src *'))), true)
+t("no default-src 'none' fails", !!cspProblem(page(policy.replace("default-src 'none'; ", ''))), true)
+t('a script host in script-src fails', !!cspProblem(page(policy.replace("script-src 'self'", "script-src 'self' https://cdn.example"))), true)
+t('the meta not first after the charset fails', !!cspProblem(page(policy, '<meta name="x" content="y">')), true)
+if (bad) { console.error(`${bad} failed`); process.exit(1) }
+console.log('test_keyring_csp: OK')
