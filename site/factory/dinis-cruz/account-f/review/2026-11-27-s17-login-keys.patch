+#!/usr/bin/env node
+/* test_keyring.mjs: assets/login/keyring.js (cl-6.security's S17): the key is made in the browser, the backup opens only with the passphrase, the file holds no
+ * plain private half, the passphrase minimum holds, a changed file is refused, signing needs a user gesture, and the fingerprint is the site's scheme.
+ *   node newsroom/build/tests/test_keyring.mjs   Written by cl-6.dev@PrompTugal.dinis, 27 Nov 2026. */
+import fs from 'node:fs'
+import vm from 'node:vm'
+import crypto, { webcrypto } from 'node:crypto'
+const SRC = fs.readFileSync(new URL('../../../assets/login/keyring.js', import.meta.url), 'utf8')
+const fresh = (active = true, pre = {}) => {
+    const store = new Map(Object.entries(pre)), win = { crypto: webcrypto, localStorage: { getItem: k => store.get(k) ?? null, removeItem: k => store.delete(k), setItem: (k, v) => store.set(k, v) } }
+    const ctx = { window: win, document: { currentScript: null }, crypto: webcrypto, navigator: { userActivation: { isActive: active } }, fetch: async () => ({ json: async () => ({ keys: [] }) }), TextEncoder, TextDecoder, atob, btoa, Uint8Array, JSON, Promise, Math, Error, Number, String, Object, Array }
+    ctx.localStorage = win.localStorage; vm.runInNewContext(SRC, ctx); return { KR: win.PTKeyring, win, ctx, store }
+}
+let bad = 0
+const t = (what, got, want) => { if (JSON.stringify(got) !== JSON.stringify(want)) { bad++; console.error(`FAIL ${what}: ${JSON.stringify(got)}, want ${JSON.stringify(want)}`) } }
+const rejects = async (what, p, re) => { try { await p; bad++; console.error(`FAIL ${what}: did not throw`) } catch (e) { if (!re.test(String(e && e.message))) { bad++; console.error(`FAIL ${what}: ${e.message}`) } } }
