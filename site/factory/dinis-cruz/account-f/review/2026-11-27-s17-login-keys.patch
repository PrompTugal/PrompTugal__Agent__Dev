diff --git a/assets/login/key.js b/assets/login/key.js
new file mode 100644
index 000000000..e03bb23d3
--- /dev/null
+++ b/assets/login/key.js
@@ -0,0 +1,53 @@
+// /login/key/: make your key here, or unlock it from your backup file (cl-6.dev@PrompTugal.dinis, 27 Nov 2026, for cl-6.security's S17).
+// A bare page with its own strict Content-Security-Policy (assets/login/key-page.json): no inline script or style, no third-party host.
+// The key is made in this browser (assets/login/keyring.js), the private halves leave only in the backup file the person downloads, and the page
+// shows the PUBLIC half to send for enrolment. Signing happens only in the click handler of "Sign this text", over the exact text shown.
+// Its words are data: assets/login/key-words.json.
+(async () => {
+    'use strict'
+    const mount = document.querySelector('.pt-key'); if (!mount) return
+    const root = (document.currentScript && document.currentScript.src || '').replace(/assets\/login\/key\.js.*$/, '') || '/'
+    let W = {}; try { W = await (await fetch(root + 'assets/login/key-words.json')).json() } catch { }
+    // the frame guard must pass before the key is used (a page in someone else's frame could be clicked for you)
+    if (window.top !== window) { mount.textContent = W.framed || ''; return }
+    const h = (tag, attrs = {}, kids = []) => { const e = document.createElement(tag); for (const [k, v] of Object.entries(attrs)) { if (k === 'text') e.textContent = v; else if (k.startsWith('on')) e.addEventListener(k.slice(2), v); else e.setAttribute(k, v) } for (const c of [].concat(kids)) if (c) e.append(c); return e }
+    const KR = () => window.PTKeyring
+    const say = (box, t, bad) => { box.textContent = t; box.className = 'pt-login-msg' + (bad ? ' bad' : '') }
+    const download = (name, text) => { const a = h('a', { href: URL.createObjectURL(new Blob([text], { type: 'application/json' })), download: name }); document.body.append(a); a.click(); a.remove() }
+    const cap = p => p.charAt(0).toUpperCase() + p.slice(1)
+
+    async function draw() {
+        const K = KR(); await K.ready.catch(() => { })
+        mount.textContent = ''
+        if (K.upgraded) mount.append(h('p', { class: 'pt-login-state warn', role: 'status', text: W.upgraded }))
+        if (K.fingerprint) return drawHeld(K)
+        mount.append(makeBox(), unlockBox())
+    }
+    const pass = (label, auto) => h('input', { type: 'password', autocomplete: auto, 'aria-label': label, placeholder: label })
+    const remember = () => { const c = h('input', { type: 'checkbox' }); return [c, h('label', { text: W.remember })] }
+    function makeBox() {
+        const p1 = pass(W.pass1, 'new-password'), p2 = pass(W.pass2, 'new-password'), [rem, remLabel] = remember(), msg = h('p', { role: 'status', class: 'pt-login-msg' })
+        return h('div', { class: 'pt-login-ways' }, [h('h2', { text: W.make_h }), h('p', { text: W.make_p }), p1, p2, rem, remLabel,
+            h('button', { type: 'button', text: W.make_btn, onclick: async () => {
+                if (p1.value !== p2.value) return say(msg, W.differ, true)
+                try { const r = await KR().make(p1.value, rem.checked); download('promptugal-key-backup.json', r.backup); await draw(); mount.prepend(h('p', { class: 'pt-login-state ok', role: 'status', text: W.made })) } catch (e) { say(msg, String(e && e.message || e), true) }
+            } }), msg])
+    }
+    function unlockBox() {
+        const file = h('input', { type: 'file', accept: 'application/json,.json', 'aria-label': W.unlock_h }), pw = pass(W.pass_label, 'current-password'), [rem, remLabel] = remember(), msg = h('p', { role: 'status', class: 'pt-login-msg' })
+        return h('div', { class: 'pt-login-ways' }, [h('h2', { text: W.unlock_h }), h('p', { text: W.unlock_p }), file, pw, rem, remLabel,
+            h('button', { type: 'button', text: W.unlock_btn, onclick: async () => {
+                try { if (!file.files[0]) return say(msg, W.pick, true); await KR().unlock(await file.files[0].text(), pw.value, rem.checked); await draw() } catch (e) { say(msg, String(e && e.message || e), true) }
+            } }), msg])
+    }
+    function drawHeld(K) {
+        const msg = h('p', { role: 'status', class: 'pt-login-msg' }), text = `promptugal.news/login ${K.fingerprint} ${new Date().toISOString()}`
+        mount.append(h('div', { class: 'pt-login-state ' + (K.person ? 'ok' : 'warn') }, [
+            h('p', { class: 'pt-login-who' }, [K.person ? h('b', { text: cap(K.person) }) : W.unlocked, ` · key ${K.fingerprint}`]), h('p', { text: K.person ? W.enrolled : W.unenrolled })]),
+            h('h2', { text: W.pub_h }), h('textarea', { rows: '8', readonly: '', 'aria-label': W.pub_h, spellcheck: 'false', text: JSON.stringify(K.publicKeys(), null, 2) }),
+            h('div', { class: 'pt-login-ways' }, [h('h2', { text: W.prove_h }), h('p', { text: W.prove_p }), h('pre', { text }),
+                h('button', { type: 'button', text: W.prove_btn, onclick: async () => { try { say(msg, W.signed + (await K.sign(text)).slice(0, 32) + '…') } catch (e) { say(msg, String(e && e.message || e), true) } } }), msg]),
+            h('button', { type: 'button', class: 'pt-login-out', text: W.lock_btn, onclick: async () => { await K.lock(); await draw() } }))
+    }
+    draw()
+})()
