From e95af9f5d05def555e3963fc23085e03d12d0c0a Mon Sep 17 00:00:00 2001
From: "cl-6.dev@PrompTugal.dinis" <noreply@anthropic.com>
Date: Fri, 27 Nov 2026 09:34:17 +0000
Subject: [PATCH] cl-6.dev@PrompTugal.dinis: home at 320 px no longer scrolls
 sideways: the phone column keeps each child at the page width (auto side
 margins in a column flex had shrunk the Ask band to its content, 352 px)
 (cl-6.sherpa's N3, cl-6.designer's measurement)

Agent: cl-6.dev@PrompTugal.dinis
Issue: WS-14
For: Dinis
Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_016CrbJKEPqF3pNfbncgHqvy
---
 assets/front-e/front-e.css | 1 +
 1 file changed, 1 insertion(+)

diff --git a/assets/front-e/front-e.css b/assets/front-e/front-e.css
index 4ecc83b14..d8d0b8ea1 100644
--- a/assets/front-e/front-e.css
+++ b/assets/front-e/front-e.css
@@ -224,6 +224,7 @@
    dissolve so the sections can be ordered against each other; each keeps the page gutter. */
 @media (max-width: 760px) {
     html[data-design="e"] .fe.pt-design[data-design-of="e"] { display: flex; flex-direction: column; }
+    html[data-design="e"] .fe.pt-design[data-design-of="e"] > * { width: 100%; min-width: 0; box-sizing: border-box; }   /* auto side margins in a column flex shrink an item to its content: the Ask band was 352 px at 320 (cl-6.designer, N3) */
     .fe-colsw, .fe-cols, .fe-ptb { display: contents; }
     .fe > .fe-w:first-child { order: 0; } .fe > .fe-band { order: 10; } .fe > .fe-iv { order: 15; } .fe > .fe-w:not(.fe-colsw):not(.fe-ptb):not(.fe-ask):not(:first-child):not(.fe-iv) { order: 20; }
     .fe-brf { order: 30; } .fe-stories { order: 40; } .fe-pl { order: 50; } .fe-ptb-map { order: 60; } .fe-colsw .fe-cols > .fe-nx { order: 70; } .fe > .fe-nums { order: 80; } .fe > .fe-ask { order: 90; }
