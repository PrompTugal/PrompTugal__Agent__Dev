diff --git a/assets/meter/meter.css b/assets/meter/meter.css
index 00a61a829..3c6531c74 100644
--- a/assets/meter/meter.css
+++ b/assets/meter/meter.css
@@ -70,9 +70,12 @@
 .nr-foot > summary::-webkit-details-marker { display: none; }
 .nr-foot > summary a { color: var(--brand, #006600); }
 .nr-foot-in { display: flex; flex-wrap: wrap; gap: 6px 14px; align-items: center; margin-top: 8px; }
-/* on a phone the figure stays and the label goes (designer@'s spec of 26 Nov 2026: a phone reader sees the balance; it was hidden outright) */
+/* on a phone the long label goes and a short word takes its place: "Credit £4.97" (designer@ and synthetic@, 26 Nov 2026) */
 @media (max-width: 767px) { .tool.meter .meter-label, .ctop-tools .tool.meter .meter-label, html[data-top="c"] .ctop-tools .tool.meter .meter-label { display: none !important; } }
 
 .nr-zero { flex: 1 1 100%; margin-top: 6px; padding-top: 8px; border-top: 1px solid var(--hair, #d9d2c1); }
 .nr-zero p { margin: 0 0 6px; }
 .nr-zero-row { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 14px; }
+
+.tool.meter .meter-short { display: none; font-family: var(--sans, system-ui, sans-serif); color: var(--ink-3, #595c64); }
+@media (max-width: 767px) { .tool.meter .meter-short { display: inline; } }
diff --git a/assets/meter/meter.js b/assets/meter/meter.js
index c690cb875..3c156d5e1 100644
--- a/assets/meter/meter.js
+++ b/assets/meter/meter.js
@@ -143,7 +143,7 @@
         var b = m.state.balance
         a.classList.toggle('is-low', b < 100)
         var shown = m.money(Math.max(0, b))   // never a minus sign (designer@'s spec, 26 Nov 2026)
-        a.replaceChildren(h('span', { class: 'meter-label' }, b > 0 ? 'Pay for what you read · ' : 'Credit used · keep reading · '), shown)
+        a.replaceChildren(h('span', { class: 'meter-label' }, b > 0 ? 'Pay for what you read · ' : 'Credit used · keep reading · '), h('span', { class: 'meter-short' }, 'Credit '), shown)   // a phone says what the number is: "Credit £4.97" (designer@, 26 Nov, on synthetic@'s N1)
         a.setAttribute('aria-label', 'Reading credit ' + shown + ', kept in this browser: your account')
         a.title = b > 0 ? 'You start with ' + m.money(m.cfg.start) + ' of reading credit, kept in this browser. It goes down as you read, by how much of a page you read. When it runs out you can still read everything.' : 'Your credit is used. You can still read everything. Top-ups are coming soon.'
     }
