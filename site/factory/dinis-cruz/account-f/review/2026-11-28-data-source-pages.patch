+// test-source-health.mjs: the health block escapes every value and links only http(s)   node scripts/test-source-health.mjs   (cl-6.dev@PrompTugal.dinis)
+import { healthBlocks, tree, when, verdict } from './build/source-health.mjs';
+let bad = 0;
+const t = (what, got, want) => { if (JSON.stringify(got) !== JSON.stringify(want)) { bad++; console.error(`FAIL ${what}: ${JSON.stringify(got)}, want ${JSON.stringify(want)}`); } };
+const H = { title: 'T', generated_utc: '2026-11-28T01:00:00Z', source_home: 'javascript:alert(1)', schedule: { card_says: '<b>x</b>', really: 'y' },
+  last_run: { at: '2026-11-28T00:00:00Z', ok: 1, failed: 1, requests: [{ name: '<img src=x onerror=1>', status: 200, bytes: 5, changed: true, meaning: '<script>alert(1)</script>' }] },
+  problems: [{ request: 'r', url: 'javascript:alert(1)', status: [403], plain: '"><script>x</script>', failed_in: 'all' }],
+  runs: [{ at: '2026-11-28T00:00:00Z', ok: 1, failed: 1, changed_requests: [], failed_requests: ['r'], commit: 'abc', commit_url: 'data:text/html,<script>1</script>', compare_with_previous_run_url: null }],
+  copies: { files_in_git_data: 1, bytes_in_git_data: 10, files_in_vault_working_copy: 0, bytes_in_vault_working_copy: 0, dated_copies_in_vault: 0, where: {} }, held: null };
+const html = healthBlocks({ id: 'x', card: { title: 'T' }, health: H, latest: { a: '<script>1</script>', b: [1, 2] } }).map(b => b.x || '').join('');
+t('no raw script or img tag from a feed', [/<script/i.test(html), /<img/i.test(html), /<b>x/.test(html)], [false, false, false]);
+t('a javascript: or data: URL is never a link', [/href="javascript:/i.test(html), /href="data:/i.test(html)], [false, false]);
