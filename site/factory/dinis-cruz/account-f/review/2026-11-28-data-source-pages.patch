+  return `<ul class="sh-tree">${rows}${more > 0 ? `<li class="sh-mono">... ${more} more, in the file</li>` : ''}</ul>`;
+}
+
+export function healthBlocks(s) {
+  const H = s.health; if (!H || !H.last_run) return [];
+  const L = s.latest, lr = H.last_run, runs = H.runs || [], pr = H.problems || [], cp = H.copies || {}, sch = H.schedule || {}, nreq = (lr.requests || []).length;
+  const [vw, vk] = verdict(H), failedNow = new Set((runs[0] && runs[0].failed_requests) || []);
