+  const title = String(H.title || s.card.title || s.id);
+  const out = [];
+  out.push(raw(`<p class="sh-back"><a href="/status/">&larr; All sources (status)</a></p><div class="sh-top"><p class="sh-sub"></p><span class="sh-badge sh-${vk}">${esc(vw)}</span></div><p class="sh-mono">Health read ${esc(when(H.generated_utc))}${H.source_home ? ` · source ${A(H.source_home, String(H.source_home).replace(/^https?:\/\//, '').split('/')[0])}` : ''}</p>`,
+    `Status: ${vw}. Health read ${when(H.generated_utc)}.`));
+  const hd = held(H, L);
+  if (hd.html) out.push(h('The data held'), raw(hd.html, hd.md));
+  // when it is collected: the card and the collector can disagree, and the page says so
+  const mism = sch.card_says && sch.really && sch.card_says !== sch.really;
+  out.push(h('When it is collected'), raw(`<dl class="sh-sch"><dt>The card says</dt><dd>${esc(sch.card_says || '')}</dd><dt>It really runs</dt><dd>${esc(sch.really || '')}</dd><dt>Last run</dt><dd>${esc(when(lr.at))}</dd></dl>${mism ? `<p class="sh-mis"><b>These disagree.</b> The card says "${esc(sch.card_says)}"; the collector runs ${esc(sch.really)}.</p>` : ''}`,
+    `- The card says: ${sch.card_says}\n- It really runs: ${sch.really}\n- Last run: ${when(lr.at)}${mism ? '\n\nThese disagree.' : ''}`));
+  // what is wrong: each failed request by name, its status, what it means and the runs it failed in
+  out.push(h('What is wrong'));
+  if (pr.length) out.push(p(`${pr.length} of ${nreq} requests are refused or failing. The rest are read normally.`), raw(`<ul class="sh-req">${pr.map(x => `<li class="sh-bad"><div class="sh-rn">${esc(x.request)}</div><div><b>${esc([].concat(x.status).join(', '))}</b> · ${esc(x.plain)} · failed in ${esc(x.failed_in)}</div><div class="sh-mono">${A(x.url, String(x.url || '').length > 80 ? String(x.url).slice(0, 77) + '...' : x.url)}</div></li>`).join('')}</ul>`,
+    pr.map(x => `- ${x.request}: ${[].concat(x.status).join(', ')}, ${x.plain}, failed in ${x.failed_in}`).join('\n')));
+  else out.push(p(`Nothing is wrong. ${num(lr.ok)} of ${nreq} requests were read normally.`));
+  // the last run, request by request
+  out.push(h('The last run, request by request'), raw(`<ul class="sh-req">${(lr.requests || []).map(r => `<li class="${failedNow.has(r.name) ? 'sh-bad' : ''}"><div class="sh-rn">${esc(r.name)}</div><div><b>${esc(r.status)}</b> · ${bytes(num(r.bytes))} · ${r.changed ? 'changed' : 'same as before'}</div><div class="sh-note">${esc(r.meaning || '')}</div></li>`).join('')}</ul>`,
+    (lr.requests || []).map(r => `- ${r.name}: ${r.status}, ${bytes(num(r.bytes))}, ${r.changed ? 'changed' : 'same'}`).join('\n')));
+  // run history: the newest five open, the rest behind a fold (maestro and cl-6.designer, 28 Nov)
+  const runLi = r => `<li><div><b>${esc(when(r.at))}</b> · ${num(r.ok)} read, ${num(r.failed)} failed · ${(r.changed_requests || []).length} changed</div><div class="sh-mono">${A(r.commit_url, `commit ${r.commit}`)}${r.compare_with_previous_run_url ? ` · ${A(r.compare_with_previous_run_url, 'what changed since the run before')}` : ' · oldest run kept, nothing to compare with'}</div>` +
+    (r.requests_detail && r.requests_detail.length ? `<details><summary>The ${r.requests_detail.length} requests of this run</summary><ul class="sh-list">${r.requests_detail.map(q => `<li><span class="sh-rn">${esc(q.name)}</span> <span class="sh-mono">${esc(q.status)} · ${bytes(num(q.bytes))} · ${esc(q.sha256_prefix || '')} · ${q.changed ? 'changed' : 'same'}</span></li>`).join('')}</ul></details>` : '') + '</li>';
+  const strip = [...runs].reverse().map(r => `<span class="sh-c ${r.failed_requests && r.failed_requests.length ? 'sh-bad' : ''}" title="${esc(when(r.at))}">${r.failed_requests && r.failed_requests.length ? '&#9650;' : '&#9679;'}</span>`).join('');
+  out.push(h('Run history'), raw(`<div class="sh-strip" role="img" aria-label="Last ${runs.length} runs, oldest first">${strip}</div><p class="sh-mono">Oldest to newest, last ${runs.length} runs kept. &#9679; every request read · &#9650; at least one failed</p><p>${changedRuns} of the last ${runs.length} runs found something new.</p><ul class="sh-runs">${runs.slice(0, 5).map(runLi).join('')}</ul>` +
+    (runs.length > 5 ? `<details class="sh-older"><summary>Show older runs (${runs.length - 5})</summary><ul class="sh-runs">${runs.slice(5).map(runLi).join('')}</ul></details>` : ''),
+    runs.map(r => `- ${when(r.at)}: ${num(r.ok)} read, ${num(r.failed)} failed, ${(r.changed_requests || []).length} changed, commit ${r.commit}`).join('\n')));
+  if (H.cadence_advice && H.cadence_advice.line) out.push(h('Does it need calling more often?'), p(H.cadence_advice.line), p(`A suggestion from ${num(H.cadence_advice.runs_kept)} runs over ${num(H.cadence_advice.days_covered)} days; ${num(H.cadence_advice.runs_with_change)} found something new.`));
+  // across runs: requests by runs, scrolls inside its own box
