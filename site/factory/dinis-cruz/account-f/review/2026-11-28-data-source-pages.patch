+  const key = L && Object.keys(L).find(k => Array.isArray(L[k]) && L[k].length && L[k][0] && typeof L[k][0] === 'object' && (!d.from || d.from.includes(`"${k}"`)));
+  const df = d.date_field, items = key ? [...L[key]].filter(i => i && i[df]).sort((a, b) => String(b[df]).localeCompare(String(a[df]))).slice(0, 5) : [];
+  const label = i => String(i.id || i.title || i.name || i.organisation || i.url || '').slice(0, 90);
+  const li = items.map(i => `<li><b>${esc(label(i))}</b> <span class="sh-mono">${esc(String(i[df]).slice(0, 16).replace('T', ' '))}${/T/.test(String(i[df])) ? ' UTC' : ''}</span></li>`).join('');
+  const html = `<div class="sh-fig"><b>${num(d.items)}</b> ${esc(d.noun || 'items')} held${d.earliest ? `, ${esc(d.earliest)} to ${esc(d.latest || '')}` : ''}` +
+    (per.length ? `<svg class="sh-hist" viewBox="0 0 ${per.length * W} 60" preserveAspectRatio="none" role="img" aria-label="Items per day, oldest to newest">${bars}</svg><p class="sh-mono">Items per day, oldest to newest (${per.length} days).</p>` : '') + `</div>` +
+    (li ? `<h3>Newest five</h3><ul class="sh-list">${li}</ul>` : '');
+  const md = `${num(d.items)} ${d.noun || 'items'} held${d.earliest ? `, ${d.earliest} to ${d.latest || ''}` : ''}.` + (items.length ? '\n\nNewest five:\n' + items.map(i => `- ${label(i)}, ${String(i[df]).slice(0, 16)}`).join('\n') : '');
+  return { html, md };
+}
+
+// the JSON tree: nested details, text only, capped (the whole file is one link away)
+export function tree(v, budget = { n: 600 }, depth = 0) {
+  const leaf = x => `<span class="sh-v">${esc(typeof x === 'string' ? (x.length > 160 ? x.slice(0, 157) + '...' : x) : String(x))}</span>`;
+  if (v === null || typeof v !== 'object') return leaf(v);
+  const arr = Array.isArray(v), entries = arr ? v.slice(0, 12).map((x, i) => [i, x]) : Object.entries(v).slice(0, 40), more = (arr ? v.length : Object.keys(v).length) - entries.length;
+  if (!entries.length) return `<span class="sh-v">${arr ? '[]' : '{}'}</span>`;
