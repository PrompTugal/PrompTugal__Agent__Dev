+// The health block at the top of a source's page (cell 2026-11-28-data-source-pages; cl-6.designer's design a1b5568 and 5036841, v1.2).
+// Built from data/<id>/health.json (cl-6.data) and, for "the data held" and the JSON tree, data/<id>/latest.json: nothing is explained that the files do not explain.
+// Every value is escaped as text; no script, no inline style, no third-party code (the JSON tree is nested details). Written by cl-6.dev@PrompTugal.dinis.
+import { esc } from './render.mjs';
+import { raw, h, p } from './render.mjs';
+
+const MON = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
+// "27 Nov 18:06 UTC"; anything that is not an ISO time is shown as given, escaped
+export const when = s => { const m = /^(\d{4})-(\d\d)-(\d\d)T(\d\d):(\d\d)/.exec(String(s || '')); return m ? `${+m[3]} ${MON[+m[2] - 1]} ${m[4]}:${m[5]} UTC` : String(s ?? ''); };
+export const bytes = n => n >= 1e6 ? `${(n / 1e6).toFixed(1)} MB` : n >= 1e3 ? `${Math.round(n / 1e3)} KB` : `${n || 0} B`;
+// a link only to http(s), never a script or data URL
+const safe = u => /^https?:\/\/[^\s"'<>]+$/i.test(String(u || '')) ? String(u) : '';
+const A = (u, text, ext = true) => safe(u) ? `<a href="${esc(safe(u))}"${ext ? ' target="_blank" rel="noopener"' : ''}>${esc(text)}</a>` : esc(text);
+const num = v => Number.isFinite(+v) ? +v : 0;
+
+export const verdict = H => { const pr = H.problems || [], lr = H.last_run || {}; return !pr.length ? ['Healthy', 'ok'] : (num(lr.ok) === 0 ? ['Failing', 'bad'] : ['Partly failing', 'warn']); };
+
+// the list of items the page says it holds, and its newest five, from latest.json
+function held(H, L) {
+  const d = H.held; if (!d || !d.items) return { html: '', md: '' };
+  const per = (d.per_day || []).filter(x => x && x.date && num(x.count) >= 0), mx = Math.max(1, ...per.map(x => num(x.count)));
