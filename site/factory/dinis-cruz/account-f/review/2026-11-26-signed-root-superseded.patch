From e859d8ad362c7ec48dc6b21d954865d31bad7d8e Mon Sep 17 00:00:00 2001
From: "cl-6.dev@PrompTugal.dinis" <noreply@anthropic.com>
Date: Thu, 26 Nov 2026 11:22:46 +0000
Subject: [PATCH] cl-6.dev@PrompTugal.dinis: gate: signed-root: a superseded
 key vouches only for a commit at or before its superseded_in

cl-6.security's change to the signed-root gate (26 Nov): an active dev or conductor key vouches for any commit; a superseded key only for a commit that is an ancestor of (or equal to) its superseded_in (git merge-base --is-ancestor, the proof of superseded.cjs); no superseded_in counts for nothing. Tests: the same superseded key before superseded_in passes, after it fails.

Agent: cl-6.dev@PrompTugal.dinis
Issue: WS-14
For: Dinis
Claude-Session: https://claude.ai/code/session_016CrbJKEPqF3pNfbncgHqvy

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 newsroom/build/lib/signed-root.mjs        | 34 +++++++++----
 newsroom/build/tests/test_signed_root.mjs | 61 ++++++++++++++++-------
 2 files changed, 66 insertions(+), 29 deletions(-)

diff --git a/newsroom/build/lib/signed-root.mjs b/newsroom/build/lib/signed-root.mjs
index fd0e8c27f..39a79a590 100644
--- a/newsroom/build/lib/signed-root.mjs
+++ b/newsroom/build/lib/signed-root.mjs
@@ -17,30 +17,44 @@ const SSH = /^(ecdsa-sha2-nistp256|ssh-ed25519) AAAA[A-Za-z0-9+/]{40,}={0,3}$/
 const git = (cwd, args) => execFileSync('git', args, { cwd, encoding: 'utf8', maxBuffer: 1 << 26, stdio: ['ignore', 'pipe', 'pipe'] })
 const tryGit = (cwd, args) => { try { return git(cwd, args) } catch { return null } }
 
-// the allowed signers from board/keys.json: every key of a dev or conductor agent that is not revoked
-export function signersFrom(keysJson) {
-    const out = []
+// the keys of board/keys.json that may sign these files, by status (cl-6.security, 26 Nov 2026): an ACTIVE dev or conductor key vouches for any
+// commit; a SUPERSEDED key vouches only for a commit that is an ancestor of (or equal to) its superseded_in commit, the same proof as
+// superseded.cjs: its private half outlives its session, so it must never sign a new change. A superseded key without superseded_in, a
+// revoked one, or one with no ssh field counts for nothing.
+export function keysFrom(keysJson) {
+    const active = [], superseded = []
     for (const k of (keysJson && keysJson.keys) || []) {
         const ssh = String(k.ssh || '').trim()
-        if (AGENTS.test(k.agent || '') && k.status !== 'revoked' && SSH.test(ssh)) out.push(`${k.agent} namespaces="git" ${ssh}`)
+        if (!AGENTS.test(k.agent || '') || !SSH.test(ssh)) continue
+        const line = `${k.agent} namespaces="git" ${ssh}`
+        if (k.status === 'active') active.push(line)
+        else if (k.status === 'superseded' && k.superseded_in) superseded.push({ line, in: String(k.superseded_in) })
     }
-    return out
+    return { active, superseded }
 }
 
 export function checkSignedRoot({ root = ROOT, files = ROOT_FILES, keys = null } = {}) {
     const errors = []
     if (!keys) { try { keys = JSON.parse(fs.readFileSync(path.join(root, 'board/keys.json'), 'utf8')) } catch { return ['board/keys.json: unreadable'] } }
-    const signers = signersFrom(keys)
-    if (!signers.length) return ['no dev or conductor key in board/keys.json']
-    const tmp = fs.mkdtempSync(path.join(os.tmpdir(), 'signed-root-')), allowed = path.join(tmp, 'allowed_signers')
-    fs.writeFileSync(allowed, signers.join('\n') + '\n')
+    const { active, superseded } = keysFrom(keys)
+    if (!active.length && !superseded.length) return ['no dev or conductor key in board/keys.json']
+    const tmp = fs.mkdtempSync(path.join(os.tmpdir(), 'signed-root-'))
+    const verify = (c, lines) => { const f = path.join(tmp, 'allowed_signers'); fs.writeFileSync(f, lines.join('\n') + '\n')
+        return tryGit(root, ['-c', 'gpg.format=ssh', '-c', 'gpg.ssh.program=ssh-keygen', '-c', `gpg.ssh.allowedSignersFile=${f}`, 'verify-commit', c]) !== null }
     try {
         for (const f of files) {
             if (!fs.existsSync(path.join(root, f))) { errors.push(`${f}: missing`); continue }
             if ((tryGit(root, ['status', '--porcelain', '--', f]) || '').trim()) { errors.push(`${f}: changed and not committed`); continue }
             const c = (tryGit(root, ['log', '--first-parent', '-1', '--format=%H', '--', f]) || '').trim()
             if (!c) { errors.push(`${f}: no commit found (the gate needs the repository's history)`); continue }
-            if (tryGit(root, ['-c', 'gpg.format=ssh', '-c', 'gpg.ssh.program=ssh-keygen', '-c', `gpg.ssh.allowedSignersFile=${allowed}`, 'verify-commit', c]) === null) errors.push(`${f}: last changed by ${c.slice(0, 9)}, not signed by a dev or conductor key in board/keys.json`)
+            let ok = active.length > 0 && verify(c, active)
+            // a superseded key: only for a commit at or before the commit that superseded it
+            for (const s of superseded) {
+                if (ok) break
+                const at = (tryGit(root, ['rev-parse', '--verify', '-q', `${s.in}^{commit}`]) || '').trim()
+                if (at && tryGit(root, ['merge-base', '--is-ancestor', c, at]) !== null && verify(c, [s.line])) ok = true
+            }
+            if (!ok) errors.push(`${f}: last changed by ${c.slice(0, 9)}, not signed by an active dev or conductor key (or a superseded one before its superseded_in)`)
         }
     } finally { fs.rmSync(tmp, { recursive: true, force: true }) }
     return errors
diff --git a/newsroom/build/tests/test_signed_root.mjs b/newsroom/build/tests/test_signed_root.mjs
index 65b63ae2d..81a97d7d1 100644
--- a/newsroom/build/tests/test_signed_root.mjs
+++ b/newsroom/build/tests/test_signed_root.mjs
@@ -1,44 +1,67 @@
 #!/usr/bin/env node
 /* test_signed_root.mjs: the gate's hold on place-signers.json and place-sources.json (lib/signed-root.mjs), in a real temporary git
- * repository with real SSH-signed commits.   node newsroom/build/tests/test_signed_root.mjs   Written by cl-6.dev@PrompTugal.dinis. */
+ * repository with real SSH-signed commits.   node newsroom/build/tests/test_signed_root.mjs   Written by cl-6.dev@PrompTugal.dinis.
+ * Rule (cl-6.security, 26 Nov 2026): an active dev or conductor key vouches for any commit; a superseded key only for a commit that is an
+ * ancestor of (or equal to) its superseded_in; no superseded_in, or a revoked key, counts for nothing. */
 import { execFileSync } from 'node:child_process'
 import fs from 'node:fs'
 import os from 'node:os'
 import path from 'node:path'
-import { checkSignedRoot, signersFrom } from '../lib/signed-root.mjs'
+import { checkSignedRoot, keysFrom } from '../lib/signed-root.mjs'
 
 const tmp = fs.mkdtempSync(path.join(os.tmpdir(), 'signedroot-'))
 const env = { ...process.env, GIT_CONFIG_GLOBAL: '/dev/null', GIT_CONFIG_SYSTEM: '/dev/null', GIT_AUTHOR_NAME: 't', GIT_AUTHOR_EMAIL: 't@t', GIT_COMMITTER_NAME: 't', GIT_COMMITTER_EMAIL: 't@t' }
 const run = (args) => execFileSync('git', args, { cwd: tmp, encoding: 'utf8', env })
 const key = n => { const f = path.join(tmp, n); execFileSync('ssh-keygen', ['-q', '-t', 'ecdsa', '-b', '256', '-N', '', '-f', f]); return { file: f, pub: fs.readFileSync(f + '.pub', 'utf8').trim().split(' ').slice(0, 2).join(' ') } }
-const DEV = key('dev'), COND = key('cond'), STRANGER = key('stranger')
-const keysJson = { keys: [
+const DEV = key('dev'), COND = key('cond'), OLD = key('old'), STRANGER = key('stranger'), REV = key('revoked')
+const F = ['newsroom/tools/place-signers.json', 'newsroom/tools/place-sources.json']
+const head = () => run(['rev-parse', 'HEAD']).trim()
+const keysOf = (oldIn) => ({ keys: [
     { id: 'dev-x', agent: 'cl-6.dev@PrompTugal.dinis', status: 'active', ssh: DEV.pub },
-    { id: 'cond-x', agent: 'cl-6.conductor@PrompTugal.dinis', status: 'superseded', ssh: COND.pub },
+    { id: 'cond-x', agent: 'cl-6.conductor@PrompTugal.dinis', status: 'active', ssh: COND.pub },
+    { id: 'old-x', agent: 'dev@PrompTugal.dinis', status: 'superseded', ssh: OLD.pub, ...(oldIn ? { superseded_in: oldIn } : {}) },
     { id: 'other-x', agent: 'security@PrompTugal.dinis', status: 'active', ssh: STRANGER.pub },
-    { id: 'rev-x', agent: 'dev@PrompTugal.dinis', status: 'revoked', ssh: key('revoked').pub },
-] }
-const F = ['newsroom/tools/place-signers.json', 'newsroom/tools/place-sources.json']
+    { id: 'rev-x', agent: 'dev@PrompTugal.dinis', status: 'revoked', ssh: REV.pub },
+] })
 let bad = 0
 const t = (what, got, want) => { if (JSON.stringify(got) !== JSON.stringify(want)) { bad++; console.error(`FAIL ${what}: ${JSON.stringify(got)}, want ${JSON.stringify(want)}`) } }
 const commit = (files, k, msg = 'c') => { for (const [f, c] of Object.entries(files)) { fs.mkdirSync(path.dirname(path.join(tmp, f)), { recursive: true }); fs.writeFileSync(path.join(tmp, f), c) } run(['add', '-A'])
     run(k ? ['-c', 'gpg.format=ssh', '-c', `user.signingkey=${k.file}`, 'commit', '-S', '-q', '-m', msg] : ['-c', 'commit.gpgsign=false', 'commit', '-q', '-m', msg]) }
+const chk = (keys) => checkSignedRoot({ root: tmp, keys })
 run(['init', '-q', '-b', 'dev'])
-t('signers: dev, conductor (even superseded), not security, not revoked', signersFrom(keysJson).length, 2)
-commit({ 'board/keys.json': JSON.stringify(keysJson), [F[0]]: '{}', [F[1]]: '{}' }, DEV, 'both signed by the dev key')
-t('both files signed by dev pass', checkSignedRoot({ root: tmp, keys: keysJson }), [])
-commit({ [F[1]]: '{"a":1}' }, COND, 'sources by the conductor')
-t('a conductor-signed change passes', checkSignedRoot({ root: tmp, keys: keysJson }), [])
+
+const k0 = keysFrom(keysOf(null))
+t('keysFrom: active dev and conductor only (security\'s, the revoked and the superseded-without-superseded_in count for nothing)', [k0.active.length, k0.superseded.length], [2, 0])
+t('keysFrom: a superseded key with superseded_in is kept apart', keysFrom(keysOf('abc123')).superseded.length, 1)
+
+commit({ 'board/keys.json': '{}', [F[0]]: '{}', [F[1]]: '{}' }, DEV, 'both signed by the active dev key')
+t('active dev key passes', chk(keysOf(null)), [])
+commit({ [F[1]]: '{"a":1}' }, COND, 'sources by the active conductor key')
+t('active conductor key passes', chk(keysOf(null)), [])
 commit({ [F[1]]: '{"a":2}' }, STRANGER, 'sources by another agent')
-t('another agent\'s key fails', checkSignedRoot({ root: tmp, keys: keysJson }).length, 1)
+t('another agent\'s key fails', chk(keysOf(null)).length, 1)
 commit({ [F[1]]: '{"a":3}' }, null, 'sources unsigned')
-t('an unsigned change fails', checkSignedRoot({ root: tmp, keys: keysJson }).length, 1)
-commit({ [F[1]]: '{"a":4}' }, DEV, 'fixed by the dev key')
-t('and passes again when the dev key signs it', checkSignedRoot({ root: tmp, keys: keysJson }), [])
+t('an unsigned change fails', chk(keysOf(null)).length, 1)
+commit({ [F[1]]: '{"a":4}' }, REV, 'sources by a revoked key')
+t('a revoked key fails', chk(keysOf(null)).length, 1)
+
+// the superseded key: S is the commit it was superseded in; before or at S it vouches, after S never
+commit({ [F[1]]: '{"a":5}' }, OLD, 'sources by the old dev key, while it was active')
+const S = head()
+t('a superseded key with no superseded_in counts for nothing', chk(keysOf(null)).length, 1)
+t('a superseded key vouches for the commit it was superseded in (equal)', chk(keysOf(S)), [])
+commit({ [F[0]]: '{"x":1}', [F[1]]: '{"a":5}' }, DEV, 'the dev key again, after S')
+commit({ [F[1]]: '{"a":6}' }, OLD, 'sources by the OLD key after it was superseded')
+t('the same superseded key on a commit AFTER superseded_in fails', chk(keysOf(S)).length, 1)
+commit({ [F[1]]: '{"a":7}' }, DEV, 'fixed by the active dev key')
+t('and passes again when an active key signs it', chk(keysOf(S)), [])
+t('a superseded_in that is not a commit gives nothing (fails if only it signed)', (() => { commit({ [F[1]]: '{"a":8}' }, OLD, 'old again'); return chk(keysOf('deadbeef0000')).length })(), 1)
+
+commit({ [F[1]]: '{"a":9}' }, DEV, 'restore')
 fs.writeFileSync(path.join(tmp, F[0]), '{"edited":true}')
-t('an uncommitted edit fails', checkSignedRoot({ root: tmp, keys: keysJson }).length, 1)
+t('an uncommitted edit fails', chk(keysOf(S)).length, 1)
 run(['checkout', '--', F[0]])
-t('no dev or conductor key at all fails', checkSignedRoot({ root: tmp, keys: { keys: [] } }).length, 1)
+t('no dev or conductor key at all fails', chk({ keys: [] }).length, 1)
 fs.rmSync(tmp, { recursive: true, force: true })
 if (bad) { console.error(`${bad} failed`); process.exit(1) }
 console.log('test_signed_root: OK')
