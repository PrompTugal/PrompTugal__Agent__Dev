diff --git a/newsroom/build/lib/article-flow.mjs b/newsroom/build/lib/article-flow.mjs
new file mode 100644
index 000000000..753ef5397
--- /dev/null
+++ b/newsroom/build/lib/article-flow.mjs
@@ -0,0 +1,38 @@
+// The flow of news up the levels, as front matter (cl-6.ontologist's proposal 2026-11-27, agreed by cl-6.dev): `town` and `region` are ids of the
+// places registry (data/site/places-registry.json); `builds_on` is a list of earlier articles a piece builds on (the graph verb "feeds" is derived
+// from it). The level of an article is derived, never written: local, regional, national, europe, unplaced. All optional, so untagged articles pass.
+export const LEVELS = ['local', 'regional', 'national', 'europe', 'unplaced']
+const RANK = { local: 0, regional: 1, national: 2 }
+const DAY = /^\d{4}-\d\d-\d\d/
+export const listOf = v => (Array.isArray(v) ? v : String(v == null ? '' : v).replace(/^\s*\[|\]\s*$/g, '').split(',')).map(s => String(s).trim()).filter(Boolean)
+export const rowOf = (registry, fm) => { const w = fm.town || fm.region, id = w && registry.index[String(w).toLowerCase()]; return id ? registry.places.find(p => p.id === id) || null : null }
+export const levelOfRow = r => !r ? 'unplaced' : r.country && r.country !== 'PT' ? 'europe' : r.kind === 'country' ? 'national' : r.kind === 'region' ? 'regional' : 'local'
+export const levelOfArticle = (registry, fm) => levelOfRow(rowOf(registry, fm))
+
+// articles: [{ slug, fm }]; returns the problems, each starting with the slug
+export function checkFlow(articles, registry) {
+    const out = [], by = new Map(articles.map(a => [a.slug, a]))
+    for (const a of articles) {
+        for (const k of ['town', 'region']) if (a.fm[k] && !registry.index[String(a.fm[k]).toLowerCase()]) out.push(`${a.slug}: ${k} "${a.fm[k]}" is not in the places registry`)
+        const lv = levelOfArticle(registry, a.fm), date = String(a.fm.date || '').slice(0, 10)
+        for (const s of listOf(a.fm.builds_on)) {
+            const b = by.get(s)
+            if (!b) { out.push(`${a.slug}: builds_on "${s}" is not an article`); continue }
+            if (s === a.slug) { out.push(`${a.slug}: builds_on itself`); continue }
+            if (DAY.test(date) && DAY.test(String(b.fm.date || '')) && String(b.fm.date).slice(0, 10) > date) out.push(`${a.slug}: builds_on "${s}", which is dated later`)
+            const lb = levelOfArticle(registry, b.fm)
+            if (lb in RANK && lv in RANK && RANK[lb] > RANK[lv]) out.push(`${a.slug}: builds_on "${s}", a higher level (${lb} above ${lv})`)
+        }
+    }
+    // no cycle of any length
+    const state = new Map(), stack = []
+    const visit = s => {
+        if (state.get(s) === 2) return
+        if (state.get(s) === 1) { out.push(`${s}: builds_on has a cycle (${[...stack.slice(stack.indexOf(s)), s].join(' > ')})`); return }
+        state.set(s, 1); stack.push(s)
+        for (const n of listOf((by.get(s) || { fm: {} }).fm.builds_on)) if (n !== s && by.has(n)) visit(n)
+        stack.pop(); state.set(s, 2)
+    }
+    for (const a of articles) visit(a.slug)
+    return out
+}
diff --git a/newsroom/build/tests/test_article_flow.mjs b/newsroom/build/tests/test_article_flow.mjs
new file mode 100644
index 000000000..2ccfc40fd
--- /dev/null
+++ b/newsroom/build/tests/test_article_flow.mjs
@@ -0,0 +1,20 @@
+#!/usr/bin/env node
+/* test_article_flow.mjs: the news-flow front matter rules (lib/article-flow.mjs; cl-6.ontologist's proposal of 27 Nov 2026).   node newsroom/build/tests/test_article_flow.mjs */
+import { checkFlow, levelOfArticle, listOf } from '../lib/article-flow.mjs'
+let bad = 0
+const t = (what, got, want) => { if (JSON.stringify(got) !== JSON.stringify(want)) { bad++; console.error(`FAIL ${what}: ${JSON.stringify(got)}, want ${JSON.stringify(want)}`) } }
+const registry = { index: { faro: 'faro', algarve: 'algarve', portugal: 'portugal', london: 'london' }, places: [
+    { id: 'portugal', kind: 'country', country: 'PT' }, { id: 'algarve', kind: 'region', country: 'PT' }, { id: 'faro', kind: 'municipality', country: 'PT' }, { id: 'london', kind: 'city', country: 'GB' }] }
+t('a list in brackets or bare', [listOf('[a, b-c]'), listOf('a,b'), listOf(['x']), listOf('')], [['a', 'b-c'], ['a', 'b'], ['x'], []])
+t('levels', ['faro', 'algarve', 'portugal', 'london', ''].map(w => levelOfArticle(registry, w ? { town: w } : {})), ['local', 'regional', 'national', 'europe', 'unplaced'])
+const A = (slug, fm) => ({ slug, fm: { date: '2026-11-20', ...fm } })
+t('untagged articles pass', checkFlow([A('a', {}), A('b', {})], registry), [])
+t('an unknown town is an error', checkFlow([A('a', { town: 'atlantis' })], registry).length, 1)
+t('a sound chain passes', checkFlow([A('l', { town: 'faro' }), A('r', { region: 'algarve', builds_on: '[l]', date: '2026-11-21' }), A('n', { region: 'portugal', builds_on: 'r, l', date: '2026-11-22' })], registry), [])
+t('an unknown slug, itself', checkFlow([A('a', { builds_on: '[zzz]' }), A('b', { builds_on: 'b' })], registry).length, 2)
+t('a later-dated source', checkFlow([A('a', { builds_on: 'b' }), A('b', { date: '2026-11-25' })], registry).length, 1)
+t('a higher level', checkFlow([A('l', { town: 'faro', builds_on: 'n' }), A('n', { region: 'portugal' })], registry).length, 1)
+t('europe and unplaced are not ranked', checkFlow([A('e', { town: 'london', builds_on: 'u' }), A('u', {})], registry), [])
+t('a cycle of any length', checkFlow([A('a', { builds_on: 'b' }), A('b', { builds_on: 'c' }), A('c', { builds_on: 'a' })], registry).some(e => /cycle/.test(e)), true)
+if (bad) { console.error(`${bad} failed`); process.exit(1) }
+console.log('test_article_flow: OK')
