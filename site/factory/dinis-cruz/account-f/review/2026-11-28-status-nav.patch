  "h_last": "Last activity",
  "h_next": "Next step",
  "h_repo": "Home",
- "s_blocked": "blocked",
+ "s_blocked": "waiting",
  "s_working": "working",
  "s_idle": "idle",
  "s_none": "not reported",
- "counts": "{n} agents, {b} blocked",
+ "counts": "{n} agents, {b} waiting",
  "not_read_short": "not read yet",
  "other_title": "Other teams",
  "other_about": "Agents of other teams, from the public commit log of this repository: the time of the last commit under each name, nothing more.",
@@ -47,11 +47,14 @@
  "h_role": "Role",
  "hb_articles": "{n} articles published; the newest is dated {d}.",
  "hb_build": "Site version {v}.",
- "hb_agents": "{n} agents: {w} working, {i} idle, {b} blocked.",
  "hb_data": "{n} datasets: {f} fresh, {a} archive, {p} with a source problem.",
  "d_wait": "If it waits:",
  "fold_agents": "Every agent, by desk",
  "fold_data": "Every dataset, with its source and date",
  "d_pointer": "Dinis answers in cl-6.decisions' session.",
- "fold_other": "Agents of other teams ({n})"
+ "fold_other": "Agents of other teams ({n})",
+ "hb_waiting_none": "{b} {ag} {is} waiting on a decision or a grant. 0 are working now.",
+ "hb_waiting_some": "{w} {wag} {wis} working now; {b} {is} waiting on a decision or a grant.",
+ "nav_label": "Newsroom pages",
+ "here": "You are here"
 }
diff --git a/assets/newsroom/status.css b/assets/newsroom/status.css
index da1295830..737322079 100644
--- a/assets/newsroom/status.css
+++ b/assets/newsroom/status.css
@@ -20,3 +20,8 @@
 .ns-ptr { font: 13px var(--sans); color: var(--ink-3); margin: 10px 0 0; }
 .ns-fold { margin: 8px 0 16px; } .ns-fold > summary { cursor: pointer; font: 600 14px var(--sans); padding: 6px 0; }
 @media (min-width: 1100px) { .ns-top { grid-template-columns: minmax(0, 1fr) 280px; grid-template-areas: "main rail"; } .ns-main { grid-area: main; } .ns-rail { grid-area: rail; border-inline-start: 1px solid var(--hair); padding-inline-start: 24px; } }
+/* the page list (cl-6.conductor, 28 Nov): a closed fold under 700 px, repeated at the foot; the row from 700 px */
+.ns-here { font: 600 11px var(--sans); margin-inline-start: 6px; } .ns-list a { display: block; min-height: 44px; line-height: 44px; border-bottom: 1px solid var(--hair); color: inherit; text-decoration: none; }
+.ns-list a[aria-current] { border-inline-start: 4px solid var(--ink); padding-inline-start: 8px; } .ns-pages > summary { cursor: pointer; font: 600 14px var(--sans); padding: 10px 0; min-height: 44px; box-sizing: border-box; }
+@media (max-width: 699px) { .ns-row { display: none; } }
+@media (min-width: 700px) { .ns-pages, .ns-foot { display: none; } .ns-row { flex-wrap: wrap; overflow-x: visible; } .ns-row .ns-here { display: none; } }
