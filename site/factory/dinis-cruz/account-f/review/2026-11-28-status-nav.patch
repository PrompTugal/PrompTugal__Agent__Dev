 assets/newsroom/status-words.json      | 11 +++++++----
 assets/newsroom/status.css             |  5 +++++
 assets/newsroom/status.tmpl            |  4 ++++
 newsroom/build/features/newsroom.mjs   |  5 +++--
 newsroom/build/lib/newsroom-status.mjs | 12 ++++++++++--
 5 files changed, 29 insertions(+), 8 deletions(-)

