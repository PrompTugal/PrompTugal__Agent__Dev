From: "cl-6.dev@PrompTugal.dinis" <noreply@anthropic.com>
Date: Fri, 27 Nov 2026 04:18:30 +0000
Subject: [PATCH] cl-6.dev@PrompTugal.dinis: the region label's count passes
 through Number() and is dropped unless finite, so the label can only carry a
 number (cl-6.security's nit on the map counts)

Agent: cl-6.dev@PrompTugal.dinis
Issue: WS-14
For: Dinis
Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_016CrbJKEPqF3pNfbncgHqvy
---
 newsroom/build/features/front-e.mjs | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/newsroom/build/features/front-e.mjs b/newsroom/build/features/front-e.mjs
index 7bb323531..2df28f79f 100644
--- a/newsroom/build/features/front-e.mjs
+++ b/newsroom/build/features/front-e.mjs
@@ -142,7 +142,7 @@ function ptMap(ctx, PR, named = new Set(), view = null) {
     const sc = W / ((V.lon1 - V.lon0) * k), H = Math.round((V.lat1 - V.lat0) * sc)
     const X = lo => ((lo - V.lon0) * k * sc).toFixed(1), Y = la => ((V.lat1 - la) * sc).toFixed(1)
     const land = (n, c) => (O.countries[n] || []).map(poly => put(item('mland'), { cls: c, d: poly.map(r => 'M' + r.map(([lo, la]) => `${X(lo)},${Y(la)}`).join('L') + 'Z').join('') })).join('')
-    const esc = ctx.md.esc, SC = rd('data/site/story-counts-by-place.json'), algStories = (SC && SC.places && SC.places.algarve && SC.places.algarve.rolled_up && SC.places.algarve.rolled_up.local_stories) || PR.filter(r => r.p.parent === 'algarve' || r.p.parent === 'loule').reduce((n, r) => n + r.news, 0)
+    const esc = ctx.md.esc, SC = rd('data/site/story-counts-by-place.json'), algStories = (SC && SC.places && SC.places.algarve && SC.places.algarve.rolled_up && Number.isFinite(Number(SC.places.algarve.rolled_up.local_stories)) && Number(SC.places.algarve.rolled_up.local_stories)) || PR.filter(r => r.p.parent === 'algarve' || r.p.parent === 'loule').reduce((n, r) => n + r.news, 0)
     // the towns shown in the grid carry their names (designer@, 27 Nov), each at the first spot of eight around its dot that clears the labels already placed; the other pins stay plain
     const placed = [], lbl = new Map(), SPOTS = [[7, -8, 'start'], [7, 15, 'start'], [-7, -8, 'end'], [-7, 15, 'end'], [7, 4, 'start'], [-7, 4, 'end'], [0, -17, 'middle'], [0, 26, 'middle'], [7, -22, 'start'], [7, 30, 'start'], [-7, -22, 'end'], [-7, 30, 'end'], [7, -36, 'start'], [-7, -36, 'end'], [7, 44, 'start'], [-7, 44, 'end']]
     for (const r of PR.filter(r => named.has(r.p.id) && Array.isArray(r.p.at) && (!view || inV(r.p.at))).sort((a, b) => b.news - a.news)) {
